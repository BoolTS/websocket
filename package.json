{
    "name": "@bool-ts/websocket",
    "version": "1.0.0",
    "author": "Trần Đức Tâm (Neo)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/BoolTS/websocket.git"
    },
    "main": "./dist/index.js",
    "module": "./src/index.ts",
    "devDependencies": {
        "@types/bun": "^1.4.5",
        "typescript": "^7.0.2"
    },
    "bugs": {
        "url": "https://github.com/BoolTS/websocket/issues"
    },
    "description": "WebSocket wrapper for BoolTS framework",
    "files": [
        "./dist",
        "./src"
    ],
    "homepage": "https://github.com/BoolTS/websocket-client#readme",
    "keywords": [
        "bool",
        "typescript",
        "ts",
        "bun",
        "framework",
        "websocket",
        "client-side"
    ],
    "license": "MIT",
    "private": false,
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "bun run --check ./app.build.ts && tsc --emitDeclarationOnly",
        "test": "bun run --watch ./__test/index.ts"
    },
    "type": "module",
    "types": "./dist/index.d.ts",
    "dependencies": {
        "zod": "^4.6.7"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./client": {
            "import": "./dist/client/index.js",
            "require": "./dist/client/index.js",
            "types": "./dist/client/index.d.ts"
        }
    }
}
